(version 1)
# Custom Design Rules (DRC) for KiCad 9.0 (Stored in '<project>.kicad_dru' file).
#
# Matching JLCPCB capabilities: https://jlcpcb.com/capabilities/pcb-capabilities
#
# KiCad documentation: https://docs.kicad.org/master/id/pcbnew/pcbnew_advanced.html#custom_design_rules
#
# Inspiration
# - https://gist.github.com/darkxst/f713268e5469645425eed40115fb8b49 (with comments)
# - https://gist.github.com/denniskupec/e163d13b0a64c2044bd259f64659485e (with comments)

# JLCPCB: "We make NPTH via dry sealing film process, if customer would like a NPTH but around with pad/copper,
# our engineer will dig out around pad/copper about 0.2mm-0.25mm, otherwise the metal potion will be flowed
# into the hole and it becomes a PTH. (there will be no copper dig out optimization for single board)."
# Pad inner diameter must be 0.4-0.5 mm larger than NPTH drill => 0.2 mm annular ring minimum.
(rule "Annular ring width (NPTH)"
	(layer outer)
	(condition "A.Type == 'pad' && !A.isPlated()")
	(constraint annular_width (min 0.2mm))
)

# JLCPCB: "The minimum plated slot width is 0.5mm, which is drawn with a pad."
(rule "Plated slot minimum width"
	(condition "A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y")
	(constraint hole_size (min 0.5mm))
)

# JLCPCB: "The minimum Non-Plated Slot Width is 1.0mm, please draw the slot outline in the mechanical layer(GML or GKO)."
(rule "Non-plated slot minimum width"
	(condition "!A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y")
	(constraint hole_size (min 1.0mm))
)

#------------------------------------------------------------------------
# Section 1: JLCPCB manufacturing rules
#------------------------------------------------------------------------

(rule "Track width, outer layer (1oz copper)"
	(layer outer)
	(condition "A.Type == 'track'")
	(constraint track_width (min 0.127mm))
)

(rule "Track spacing, outer layer (1oz copper)"
	(layer outer)
	(condition "A.Type == 'track' && B.Type == A.Type")
	(constraint clearance (min 0.127mm))
)

(rule "Track width, inner layer"
	(layer inner)
	(condition "A.Type == 'track'")
	(constraint track_width (min 0.09mm))
)

(rule "Track spacing, inner layer"
	(layer inner)
	(condition "A.Type == 'track' && B.Type == A.Type")
	(constraint clearance (min 0.09mm))
)

(rule "Silkscreen text"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 1mm))
)

(rule "Pad to Silkscreen"
	(layer outer)
	(condition "A.Type == 'pad' && B.Layer == '?.Silkscreen'")
	(constraint silk_clearance (min 0.15mm))
)

(rule "Edge (routed) to track clearance"
	(condition "A.Type == 'track'")
	(constraint edge_clearance (min 0.3mm))
)

#(rule "Edge (v-cut) to track clearance"
#	(condition "A.Type == 'track'")
#	(constraint edge_clearance (min 0.4mm))
#)

# JLCPCB restrictions ambiguous:
# Illustration: 0.2 mm, 1&2 layer: 0.3 mm, multilayer: "(0.15mm more costly)"
# This rule handles diameter minimum and maximum for ALL holes.
# Other specialized rules handle restrictions (e.g. Via, PTH, NPTH)
(rule "Hole diameter"
	(constraint hole_size (min 0.2mm) (max 6.3mm))
)

(rule "Hole (NPTH) diameter"
	(layer outer)
	(condition "!A.isPlated()")
	(constraint hole_size (min 0.5mm))
)

# TODO: Hole to board edge >= 1 mm. Min. board size 10 x 10 mm
(rule "Hole (castellated) diameter"
	(layer outer)
	(condition "A.Type == 'pad' && A.Fabrication_Property == 'Castellated pad'")
	(constraint hole_size (min 0.6mm))
)

# JLCPCB: "Via diameter should be 0.1mm(0.15mm preferred) larger than Via hole size" (illustration shows diameters for both dimensions)
# JLCPCB: PTH: "The annular ring size will be enlarged to 0.15mm in production."
(rule "Annular ring width (via and PTH)"
	(layer outer)
	(condition "A.isPlated()")
	(constraint annular_width (min 0.075mm))
)

(rule "Clearance: hole to hole (perimeter), different nets"
	(layer outer)
	(condition "A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm))
)

(rule "Clearance: hole to hole (perimeter), same net"
	(layer outer)
	(condition "A.Net == B.Net")
	(constraint hole_to_hole (min 0.254mm))
)

(rule "Clearance: track to NPTH hole (perimeter)"
#	(condition "A.Pad_Type == 'NPTH, mechanical' && B.Type == 'track' && A.Net != B.Net")
	(condition "!A.isPlated() && B.Type == 'track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.254mm))
)

(rule "Clearance: track to PTH hole perimeter"
	(condition "A.isPlated() && B.Type == 'track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.33mm))
)

# TODO: try combining with rule "Clearance: PTH to track, different nets"
(rule "Clearance: track to pad"
	(condition "A.Type == 'pad' && B.Type == 'track' &&  A.Net != B.Net")
	(constraint clearance (min 0.2mm))
)

(rule "Clearance: pad/via to pad/via"
	(layer outer)
#	(condition "(A.Type == 'Pad' || A.Type == 'Via') && (B.Type == 'Pad' || B.Type == 'Via') && A.Net != B.Net")
	(condition "A.isPlated() && B.isPlated() && A.Net != B.Net")
	(constraint clearance (min 0.127mm))
)

#------------------------------------------------------------------------
# Section 2: High-voltage clearance rules
#------------------------------------------------------------------------
# IPC-2221 based clearances on FR4 with solder mask (polymer-coated traces).
# Values relaxed from B2 (uncoated) toward B3 (coated) since tracks are under
# solder mask. Pad-to-pad excluded (component-rated spacing).
#
# Voltage levels:
#   Line-to-neutral / Line-to-earth: 230V RMS = 325V peak  => 1.5 mm
#   Line-to-line (inter-phase):      400V RMS = 565V peak  => 2.0 mm
#
# Net classes:
#   HV         -- Mains (post-protection): L1/L2/L3_VOLTAGE, NEUTRAL, PS1 AC pins
#   Surge      -- Raw mains + transients: PWR1 connector, GDT pads, fuse pads
#   Earth      -- Protective earth (PE)
#   HV Divider -- Voltage divider midpoints between HV resistors and sensing resistors
#
# All other net classes (Default, Power, Low Power, CT, ANT, Gnd) are low-voltage.
#
# Pad-to-pad clearances are excluded: component pin spacing is set by the
# manufacturer and the component is rated for the voltage. These rules only
# check routed copper (traces, vias, zones) against other copper.

# HV nets to low-voltage nets: 1.5 mm (325V peak, line-to-neutral)
(rule "HV to LV clearance"
	(condition "A.NetClass == 'HV' && B.NetClass != 'HV' && B.NetClass != 'Surge' && B.NetClass != 'HV Divider' && B.NetClass != 'Earth' && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 1.5mm))
)

# Surge nets to low-voltage nets: 1.5 mm (325V peak)
(rule "Surge to LV clearance"
	(condition "A.NetClass == 'Surge' && B.NetClass != 'HV' && B.NetClass != 'Surge' && B.NetClass != 'HV Divider' && B.NetClass != 'Earth' && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 1.5mm))
)

# HV to Surge: 1.2 mm (same voltage domain, post- vs pre-protection)
(rule "HV to Surge clearance"
	(condition "A.NetClass == 'HV' && B.NetClass == 'Surge' && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 1.2mm))
)

# HV to HV Divider: 0.8 mm (divider midpoints bridge HV/LV through rated resistors)
(rule "HV to HV Divider clearance"
	(condition "A.NetClass == 'HV' && B.NetClass == 'HV Divider' && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 0.8mm))
)

# Surge to HV Divider: 1.5 mm (325V peak)
(rule "Surge to HV Divider clearance"
	(condition "A.NetClass == 'Surge' && B.NetClass == 'HV Divider' && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 1.5mm))
)

# HV Divider to LV nets: 1.5 mm (divider midpoints carry significant voltage)
(rule "HV Divider to LV clearance"
	(condition "A.NetClass == 'HV Divider' && B.NetClass != 'HV' && B.NetClass != 'Surge' && B.NetClass != 'HV Divider' && B.NetClass != 'Earth' && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 1.5mm))
)

# Earth to mains-voltage nets: 1.5 mm (325V peak, line-to-earth)
(rule "Earth to HV clearance"
	(condition "A.NetClass == 'Earth' && (B.NetClass == 'HV' || B.NetClass == 'Surge' || B.NetClass == 'HV Divider') && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 1.5mm))
)

# Earth to LV nets: 1.5 mm (earth may carry fault current)
(rule "Earth to LV clearance"
	(condition "A.NetClass == 'Earth' && B.NetClass != 'HV' && B.NetClass != 'Surge' && B.NetClass != 'HV Divider' && B.NetClass != 'Earth' && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 1.5mm))
)

# HV phase-to-neutral: 1.5 mm (230V RMS / 325V peak)
# Neutral nets in HV class: NEUTRAL, Net-(PS1-AC(N))
(rule "HV phase-to-neutral clearance"
	(condition "A.NetClass == 'HV' && B.NetClass == 'HV' && A.Net != B.Net && (A.NetName == 'NEUTRAL' || A.NetName == 'Net-(PS1-AC(N))' || B.NetName == 'NEUTRAL' || B.NetName == 'Net-(PS1-AC(N))') && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 1.5mm))
)

# HV inter-phase clearance: 2.0 mm (400V RMS / 565V peak, line-to-line)
# Excludes neutral nets — those are handled by the phase-to-neutral rule above
(rule "HV inter-phase clearance"
	(condition "A.NetClass == 'HV' && B.NetClass == 'HV' && A.Net != B.Net && A.NetName != 'NEUTRAL' && A.NetName != 'Net-(PS1-AC(N))' && B.NetName != 'NEUTRAL' && B.NetName != 'Net-(PS1-AC(N))' && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 2.0mm))
)

# Surge phase-to-neutral: 1.5 mm (325V peak)
# Neutral net in Surge class: Net-(PWR1-N)
(rule "Surge phase-to-neutral clearance"
	(condition "A.NetClass == 'Surge' && B.NetClass == 'Surge' && A.Net != B.Net && (A.NetName == 'Net-(PWR1-N)' || B.NetName == 'Net-(PWR1-N)') && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 1.5mm))
)

# Surge inter-phase clearance: 2.0 mm (400V RMS / 565V peak at the connector)
# Excludes neutral — handled by the phase-to-neutral rule above
(rule "Surge inter-phase clearance"
	(condition "A.NetClass == 'Surge' && B.NetClass == 'Surge' && A.Net != B.Net && A.NetName != 'Net-(PWR1-N)' && B.NetName != 'Net-(PWR1-N)' && !(A.Type == 'pad' && B.Type == 'pad')")
	(constraint clearance (min 2.0mm))
)
